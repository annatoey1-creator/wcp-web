---
import { site, lineLink } from '../data/site';
const nav = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/about', label: 'เกี่ยวกับเรา' },
  { href: '/products', label: 'สินค้า' },
  { href: '/oem', label: 'บริการ OEM' },
  { href: '/export', label: 'ส่งออกชายแดน' },
  { href: '/knowledge', label: 'ความรู้' },
  { href: '/contact', label: 'ติดต่อเรา' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${site.brand} หน้าแรก`}>
      <img src="/images/brand/logo-mark.jpg" alt="" width="44" height="44" />
      <span><strong>WORLD CLASS PLASTIC</strong><small>บริษัท เวิลด์คลาสพลาสติก จำกัด</small></span>
    </a>
    <nav class="desktop-nav" aria-label="เมนูหลัก">
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="btn btn-line btn-sm" href={lineLink("สนใจขอใบเสนอราคาถุงขยะ")} target="_blank" rel="noopener noreferrer">ทัก LINE</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="เปิดเมนู"><span></span><span></span><span></span></summary>
      <nav aria-label="เมนูมือถือ">
        {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn btn-line" href={lineLink("สนใจขอใบเสนอราคาถุงขยะ")} target="_blank" rel="noopener noreferrer">ทัก LINE ขอใบเสนอราคา</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--primary-900); color: #fff; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; line-height: 1.2; min-width: 0; }
  .logo img { border-radius: 50%; flex-shrink: 0; }
  .logo span { display: grid; min-width: 0; }
  .logo strong { font-family: var(--font-head); font-weight: 600; font-size: 1rem; color: #fff; letter-spacing: 0.02em; }
  .logo small { font-size: 0.78rem; color: #c9c2b6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .desktop-nav { display: none; align-items: center; gap: 4px; }
  .desktop-nav a { white-space: nowrap; }
  .desktop-nav a:not(.btn) { position: relative; color: #ece6dc; text-decoration: none; font-weight: 500; font-size: 0.95rem; padding: 8px 12px; font-family: var(--font-head); }
  .desktop-nav a:not(.btn):hover { color: var(--gold-soft); }
  .desktop-nav a[aria-current='page'] { color: #fff; }
  .desktop-nav a[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 0; height: 2px; background: var(--gold-soft); border-radius: 2px; }
  .desktop-nav .btn { margin-left: 10px; }
  .mobile-nav summary { list-style: none; cursor: pointer; display: grid; gap: 5px; padding: 12px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; }
  .mobile-nav nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--primary-900); border-top: 1px solid rgb(255 255 255 / 0.1); box-shadow: var(--shadow); display: grid; padding: 8px 16px 16px; }
  .mobile-nav nav a:not(.btn) { padding: 12px 4px; color: #ece6dc; text-decoration: none; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .mobile-nav nav a[aria-current='page'] { color: var(--gold-soft); }
  .mobile-nav nav .btn { margin-top: 12px; }
  @media (min-width: 1100px) { .desktop-nav { display: flex; } .mobile-nav { display: none; } }
</style>
