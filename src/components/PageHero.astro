---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; lead?: string; crumbs: { name: string; href?: string }[] }
const { title, lead, crumbs } = Astro.props;
---
<header class="page-hero">
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</header>
