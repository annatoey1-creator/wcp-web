---
// กล่อง CTA ท้ายบทความและท้ายหน้าสินค้า ลูกค้ากดแล้วเปิดแชต LINE พร้อมข้อความ
import { site, lineLink } from '../data/site';
interface Props { title?: string; text?: string; message?: string }
const {
  title = 'ขอรับชุดตัวอย่างทดสอบฟรี',
  text = 'ทัก LINE บอกสินค้าและจำนวนที่สนใจ ฝ่ายขายตอบกลับในแชตทันที ไม่ต้องกรอกแบบฟอร์ม',
  message = 'สนใจขอรับชุดตัวอย่างถุงขยะฟรี',
} = Astro.props;
---
<aside class="cta-sample">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="btn-row">
    <a class="btn btn-line" href={lineLink(message)} target="_blank" rel="noopener noreferrer">ทัก LINE คุยกับฝ่ายขาย</a>
    <a class="btn btn-light" href={site.contact.phoneHref}>โทร {site.contact.phone.value}</a>
  </div>
</aside>
<style>
  .cta-sample { display: grid; gap: 20px; align-items: center; background: linear-gradient(135deg, var(--green) 0%, #165c3a 100%); color: #e9f6ef; border-radius: var(--radius); padding: clamp(24px, 4vw, 40px); margin-block: 40px; }
  @media (min-width: 860px) { .cta-sample { grid-template-columns: 1fr auto; } }
  h2 { color: #fff; font-size: 1.5rem; margin-bottom: 0.3em; }
  p { margin: 0; }
</style>
