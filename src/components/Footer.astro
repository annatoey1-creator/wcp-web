---
import { site, lineLink } from '../data/site';
import { products } from '../data/products';
import Fact from './Fact.astro';
import Icon from './Icon.astro';
const c = site.contact;
---
<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <a class="logo" href="/" aria-label={`${site.brand} หน้าแรก`}>
        <img src="/images/brand/logo-mark.jpg" alt="" width="52" height="52" loading="lazy" />
        <span><strong>WORLD CLASS PLASTIC</strong><small><Fact f={site.nameTh} /></small></span>
      </a>
      <p>{site.tagline}</p>
      <ul class="contact">
        <li><Icon name="pin" size={18} /><span>ที่อยู่: <Fact f={c.address} /></span></li>
        <li><Icon name="phone" size={18} /><span>โทร: <a href={c.phoneHref}><Fact f={c.phone} /></a></span></li>
        <li><Icon name="mail" size={18} /><span>อีเมล: <Fact f={c.email} /></span></li>
      </ul>
      <p class="tax">เลขประจำตัวผู้เสียภาษี: <Fact f={c.taxId} /></p>
    </div>
    <div>
      <h2>สินค้า</h2>
      <ul>{products.map((p) => <li><a href={`/products/${p.slug}`}>{p.name}</a></li>)}</ul>
    </div>
    <div>
      <h2>บริการ</h2>
      <ul>
        <li><a href="/oem">รับผลิต OEM สร้างแบรนด์</a></li>
        <li><a href="/export">ส่งออกและการค้าชายแดน</a></li>
        <li><a href="/knowledge">คลังความรู้</a></li>
        <li><a href="/about">เกี่ยวกับเรา</a></li>
        <li><a href="/contact">ติดต่อเรา</a></li>
      </ul>
    </div>
    <div>
      <h2>ติดตามเรา</h2>
      <ul>
        <li><a href={lineLink()} target="_blank" rel="noopener noreferrer">LINE ฝ่ายขาย</a></li>
        <li><a href={c.facebook.value} target="_blank" rel="noopener noreferrer">Facebook</a></li>
      </ul>
      <a class="btn btn-line btn-sm" href={lineLink("สนใจขอใบเสนอราคาถุงขยะ")} target="_blank" rel="noopener noreferrer">ทัก LINE ขอใบเสนอราคา</a>
    </div>
  </div>
  <div class="wrap copy">© {new Date().getFullYear()} {site.brand} Co., Ltd. สงวนลิขสิทธิ์</div>
</footer>
<style>
  .site-footer { background: var(--primary-900); color: #bdb5a8; padding-top: 56px; padding-bottom: 96px; font-size: 0.95rem; }
  .cols { display: grid; gap: 32px; }
  @media (min-width: 720px) { .cols { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
  h2 { color: #fff; font-size: 1rem; margin-bottom: 12px; }
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; line-height: 1.25; margin-bottom: 14px; }
  .logo img { border-radius: 50%; }
  .logo span { display: grid; }
  .logo strong { font-family: var(--font-head); font-weight: 600; color: #fff; letter-spacing: 0.02em; }
  .logo small { font-size: 0.82rem; color: #bdb5a8; }
  ul { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
  .contact li { display: flex; gap: 10px; align-items: flex-start; }
  .contact svg { color: var(--gold-soft); flex-shrink: 0; margin-top: 4px; }
  .tax { font-size: 0.88rem; }
  a:not(.btn) { color: #ece6dc; }
  a:not(.btn):hover { color: var(--gold-soft); }
  .copy { border-top: 1px solid rgb(255 255 255 / 0.12); margin-top: 40px; padding-top: 20px; font-size: 0.85rem; }
</style>
