---
import type { Product } from '../data/products';
interface Props { p: Product }
const { p } = Astro.props;
---
<article class={`card product-card accent-${p.accent}`}>
  <img src={p.image} alt={p.imageAlt} width="400" height="300" loading="lazy" decoding="async" />
  <div class="card-body">
    <h3><a href={`/products/${p.slug}`}>{p.name}</a></h3>
    <p>{p.short}</p>
    <div class="btn-row" style="margin-top:auto;padding-top:12px">
      <a class="btn btn-navy btn-sm" href={`/products/${p.slug}`}>ดูสเปก</a>
      {p.specSheet
        ? <a class="btn btn-outline btn-sm" href={p.specSheet} download>ดาวน์โหลดตาราง</a>
        : <span class="btn btn-outline btn-sm" aria-disabled="true" title="ยังไม่มีไฟล์ PDF">ตาราง PDF (เร็วๆ นี้)</span>}
    </div>
  </div>
</article>
<style>
  .product-card { --accent: var(--navy); position: relative; }
  .product-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--accent); }
  .accent-red { --accent: var(--red); }
  .accent-green { --accent: var(--green); }
  .accent-mixed { --accent: linear-gradient(90deg, var(--red) 25%, var(--green) 25% 50%, #e0b100 50% 75%, #3b82f6 75%); }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
</style>
