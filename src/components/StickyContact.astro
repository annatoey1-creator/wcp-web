---
// แถบติดต่อด่วนมุมล่างขวา
import { site, lineLink } from '../data/site';
const c = site.contact;
---
<div class="sticky-contact" role="complementary" aria-label="ติดต่อด่วน">
  <a class:list={['line', { missing: !c.lineOaId }]} href={lineLink('สนใจสอบถามสินค้า')} rel="noopener" title={c.lineOaId ? undefined : 'รอ LINE OA จริง'}>ทัก LINE</a>
  <a class="call" href={c.phoneHref}>โทรฝ่ายขาย</a>
</div>
<style>
  .sticky-contact { position: fixed; right: 16px; bottom: 16px; z-index: 60; display: flex; gap: 8px; }
  a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 18px; border-radius: 999px; color: #fff; font-weight: 600; text-decoration: none; box-shadow: 0 6px 20px rgb(15 23 42 / 0.25); }
  .line { background: #06c755; }
  .call { background: var(--primary); }
  .missing { outline: 3px dashed var(--todo-border); outline-offset: 2px; }
</style>
