---
// หน้าติดต่อ: ไม่มีแบบฟอร์ม ลูกค้าทัก LINE คุยกับฝ่ายขายได้ทันที
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Fact from '../components/Fact.astro';
import { site, lineLink } from '../data/site';

const c = site.contact;
const tips = [
  'สินค้าที่สนใจ (ถุงแดงติดเชื้อ ถุงรีไซเคิล ถุงดำ ถุงแยกสี หรือ OEM)',
  'ขนาดและความหนา หรือแนบไฟล์ TOR',
  'ปริมาณที่ต้องการ (กก. หรือ ตัน ต่อเดือน)',
  'ถ้าต้องการชุดตัวอย่างฟรี แจ้งที่อยู่จัดส่ง',
];
---
<Base
  title="ติดต่อเรา ทัก LINE ขอใบเสนอราคา"
  description="ทัก LINE คุยกับฝ่ายขาย World Class Plastic ได้ทันที ขอใบเสนอราคาถุงขยะสำหรับองค์กรและขอรับชุดตัวอย่างฟรี ไม่ต้องกรอกแบบฟอร์ม"
>
  <PageHero
    title="ติดต่อเรา"
    lead="ทัก LINE คุยกับฝ่ายขายได้ทันที ขอใบเสนอราคาหรือชุดตัวอย่างฟรี ไม่ต้องกรอกแบบฟอร์ม"
    crumbs={[{ name: 'ติดต่อเรา' }]}
  />

  <section class="section">
    <div class="wrap layout">
      <div class="line-card" id="line">
        <h2>ทัก LINE ฝ่ายขาย</h2>
        <p class="sub">LINE ID: <Fact f={c.lineId} /></p>
        {c.lineQr
          ? <img class="qr" src={c.lineQr} alt="QR code สำหรับเพิ่มเพื่อน LINE ฝ่ายขาย" width="220" height="220" />
          : <div class="qr qr-todo"><mark class="todo">[QR code LINE OA]</mark></div>}
        <a class="btn btn-line big" href={lineLink('สนใจขอใบเสนอราคาถุงขยะ')} rel="noopener">ทัก LINE คุยกับฝ่ายขาย</a>
        <a class="btn btn-outline big" href={c.phoneHref}>หรือโทร <Fact f={c.phone} /></a>
        {!c.lineOaId && <p class="pending" role="note"><span aria-hidden="true">⚠</span><span>รอ LINE OA ID จริง (ตั้งค่าที่ src/data/site.ts → contact.lineOaId) ตอนนี้ปุ่ม LINE ทุกปุ่มจะพามาที่หน้านี้</span></p>}

        <h3>แจ้งข้อมูลนี้ในแชต จะได้ราคาเร็วขึ้น</h3>
        <ul class="checklist">{tips.map((t) => <li>{t}</li>)}</ul>
      </div>

      <aside class="info">
        <h2>ข้อมูลติดต่อ</h2>
        <ul>
          <li><strong>โทร</strong><a href={c.phoneHref}><Fact f={c.phone} /></a></li>
          <li><strong>LINE OA</strong><Fact f={c.lineId} /></li>
          <li><strong>อีเมล</strong><Fact f={c.email} /></li>
          <li><strong>เวลาทำการ</strong><Fact f={c.hours} /></li>
        </ul>
        <h2>ที่ตั้งโรงงาน</h2>
        <p><Fact f={c.address} /></p>
        {c.mapsEmbedUrl
          ? <iframe src={c.mapsEmbedUrl} title="แผนที่โรงงาน" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          : <div class="map-todo"><mark class="todo">[แผนที่ Google Maps]</mark></div>}
        <h2>ข้อมูลออกใบกำกับภาษี</h2>
        <p><Fact f={site.nameTh} /><br />เลขประจำตัวผู้เสียภาษี <Fact f={c.taxId} /></p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1.2fr 1fr; } }
  .line-card { display: grid; gap: 14px; justify-items: center; text-align: center; background: #fff; border: 1px solid var(--border); border-top: 6px solid #06c755; border-radius: var(--radius); padding: clamp(24px, 4vw, 40px); box-shadow: var(--shadow); }
  .line-card h2 { margin: 0; }
  .sub { margin: 0; color: var(--muted); }
  .qr { width: 220px; height: 220px; border-radius: 12px; border: 1px solid var(--border); }
  .qr-todo { display: grid; place-items: center; background: var(--gray-50); }
  .big { width: 100%; max-width: 360px; min-height: 56px; font-size: 1.1rem; }
  .line-card h3 { margin: 16px 0 0; font-size: 1.05rem; }
  .line-card .checklist { text-align: left; }
  .line-card .pending { text-align: left; margin: 0; }
  .info h2 { font-size: 1.15rem; margin-top: 24px; }
  .info h2:first-child { margin-top: 0; }
  .info ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .info li { display: grid; grid-template-columns: 96px 1fr; gap: 8px; }
  iframe, .map-todo { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: var(--radius); background: var(--gray-100); }
  .map-todo { display: grid; place-items: center; }
</style>
