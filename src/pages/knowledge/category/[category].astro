---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { categories, categoryKeys, type CategoryKey } from '../../../data/knowledge';

export function getStaticPaths() {
  return categoryKeys.map((category) => ({ params: { category } }));
}
const key = Astro.params.category as CategoryKey;
const cat = categories[key];
const posts = (await getCollection('knowledge', ({ data }) => !data.draft && data.category === key)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---
<Base title={`${cat.name} | คลังความรู้`} description={cat.description}>
  <PageHero title={cat.name} lead={cat.description} crumbs={[{ name: 'คลังความรู้', href: '/knowledge' }, { name: cat.name }]} />
  <section class="section">
    <div class="wrap">
      <nav class="cats" aria-label="หมวดบทความ">
        <a href="/knowledge">ทั้งหมด</a>
        {categoryKeys.map((k) => <a href={`/knowledge/category/${k}`} aria-current={k === key ? 'page' : undefined}>{categories[k].name}</a>)}
      </nav>
      {posts.length
        ? <div class="grid grid-3">{posts.map((p) => <ArticleCard post={p} />)}</div>
        : <p>ยังไม่มีบทความในหมวดนี้</p>}
    </div>
  </section>
</Base>

