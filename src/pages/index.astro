---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fact from '../components/Fact.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaSample from '../components/CtaSample.astro';
import { site, lineLink } from '../data/site';
import { products } from '../data/products';

const posts = (await getCollection('knowledge', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// ภาพสไลด์ใน hero เปลี่ยนอัตโนมัติทุก 5 วินาที
const heroSlides = [
  { src: '/images/factory/production-line.jpg', alt: 'สายการผลิตถุงพลาสติกในโรงงาน' },
  { src: '/images/gallery/packed-3.jpg', alt: 'ถุงขยะแพ็กพร้อมส่ง' },
  { src: '/images/factory/film-roll.jpg', alt: 'ม้วนฟิล์มพลาสติกในเครื่องผลิต' },
];
---
<Base
  title="World Class Plastic โรงงานผลิตและขายส่งถุงขยะ B2B รับผลิต OEM"
  description="โรงงานผลิตและขายส่งถุงขยะสำหรับองค์กร ถุงขยะติดเชื้อสีแดง ถุงขยะรีไซเคิล ถุงดำงานหนัก ถุงแยกสี และรับสร้างแบรนด์ถุงขยะ OEM ครบวงจร ทัก LINE ขอใบเสนอราคาและชุดตัวอย่างได้ทันที"
>
  <section class="hero" aria-label="แนะนำบริษัท">
    {heroSlides.map((s, i) => (
      <img class:list={['slide', { active: i === 0 }]} src={s.src} alt={i === 0 ? s.alt : ''} width="1280" height="720"
        fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
    ))}
    <div class="wrap hero-text">
      <span class="eyebrow">World Class Plastic Co.,Ltd.</span>
      <h1>โรงงานถุงพลาสติก<span>ครบวงจร รับสร้างแบรนด์ OEM</span></h1>
      <p class="lead">
        กำลังผลิต <Fact f={site.stats[0].fact} /> สต็อกพร้อมส่ง จัดส่งทั่วประเทศและชายแดน
        สำหรับโรงพยาบาล บริษัททำความสะอาด โรงงาน และเจ้าของแบรนด์
      </p>
      <ul class="badges">
        <li>✓ รับผลิต OEM สร้างแบรนด์</li>
        <li>✓ สต็อกพร้อมส่ง</li>
        <li>✓ ส่งทั่วไทยและชายแดน</li>
      </ul>
      <div class="btn-row">
        <a class="btn btn-line" href={lineLink("สนใจขอใบเสนอราคาถุงขยะสำหรับองค์กร")} rel="noopener">ทัก LINE ขอใบเสนอราคา</a>
        <a class="btn btn-primary" href={lineLink("สนใจขอรับชุดตัวอย่างถุงขยะฟรี (B2B Sample Kit)")} rel="noopener">ขอชุดตัวอย่างฟรีทาง LINE</a>
      </div>
    </div>
    <div class="dots" role="group" aria-label="เลือกภาพ">
      {heroSlides.map((_, i) => <button type="button" class:list={{ active: i === 0 }} aria-label={`ภาพที่ ${i + 1}`}></button>)}
    </div>
  </section>

  <section class="stats-wrap" aria-label="กำลังการผลิต">
    <div class="wrap grid grid-3">
      {site.stats.map((s) => (
        <div class="stat">
          <strong><Fact f={s.fact} /></strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">สินค้าหลัก</span>
        <h2>ถุงขยะ 4 กลุ่มสำหรับงานองค์กร</h2>
        <p>ทุกกลุ่มมีตารางสเปกความหนาและจำนวนใบต่อกิโลกรัม ใช้เทียบ TOR หรือคำนวณต้นทุนต่อใบได้</p>
      </div>
      <div class="grid grid-4">{products.map((p) => <ProductCard p={p} />)}</div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap oem">
      <img src="/images/oem/labels.jpg" alt="ตัวอย่างฉลากและบรรจุภัณฑ์ถุงขยะ OEM" width="700" height="500" loading="lazy" />
      <div>
        <span class="eyebrow">บริการรับสร้างแบรนด์</span>
        <h2>สร้างแบรนด์ถุงขยะของคุณเอง</h2>
        <p class="free"><mark class="todo" title="รอยืนยันเงื่อนไขบริการฟรี">ฟรี! บริการออกแบบโลโก้และแพ็กเกจจิ้งสำหรับเจ้าของแบรนด์</mark></p>
        <ul class="checklist">
          <li>สั่งขนาด สี และความหนาเฉพาะ</li>
          <li>พิมพ์โลโก้ 1–4 สี</li>
          <li>แบบม้วนหรือแบบพับ หูผูก กลิ่นหอม</li>
          <li>ขั้นต่ำยืดหยุ่นสำหรับผู้เริ่มต้น</li>
        </ul>
        <a class="btn btn-dark" href="/oem">ดูขั้นตอนรับผลิต OEM</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">มาตรฐานและการรับรอง</span>
        <h2>เอกสารที่ฝ่ายจัดซื้อขอได้</h2>
      </div>
      <ul class="certs grid grid-3">
        {site.certifications.map((c) => (
          <li><strong>{c.name}</strong><span><Fact f={c.fact} /></span></li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">คลังความรู้</span>
          <h2>บทความสำหรับฝ่ายจัดซื้อ</h2>
        </div>
        <div class="grid grid-3">{posts.map((p) => <ArticleCard post={p} />)}</div>
        <p style="margin-top:24px"><a href="/knowledge">ดูบทความทั้งหมด →</a></p>
      </div>
    </section>
  )}

  <div class="wrap"><CtaSample /></div>
</Base>

<script>
  const hero = document.querySelector('.hero');
  const slides = hero ? [...hero.querySelectorAll<HTMLElement>('.slide')] : [];
  const dots = hero ? [...hero.querySelectorAll<HTMLButtonElement>('.dots button')] : [];
  let current = 0;
  let timer: number | undefined;
  const show = (i: number) => {
    slides[current]?.classList.remove('active');
    dots[current]?.classList.remove('active');
    current = (i + slides.length) % slides.length;
    slides[current]?.classList.add('active');
    dots[current]?.classList.add('active');
  };
  const start = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || slides.length < 2) return;
    clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), 5000);
  };
  dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
  start();
</script>

<style>
  .hero { position: relative; min-height: min(80vh, 640px); display: flex; align-items: center; color: #fff; overflow: hidden; background: var(--primary-900); }
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1s ease; }
  .slide.active { opacity: 1; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(6 45 22 / 0.92) 0%, rgb(6 45 22 / 0.7) 50%, rgb(6 45 22 / 0.2) 100%); }
  @media (max-width: 799px) { .hero::after { background: rgb(6 45 22 / 0.82); } }
  .hero-text { position: relative; z-index: 2; padding-block: 64px 72px; }
  .hero-text > * { max-width: 640px; }
  .hero .eyebrow { color: var(--gold-soft); }
  .hero h1 { color: #fff; font-size: clamp(2rem, 1.3rem + 3.4vw, 3.6rem); line-height: 1.25; }
  .hero h1 span { display: block; font-size: 0.55em; color: #bfe8cc; font-weight: 500; margin-top: 6px; }
  .lead { font-size: 1.15rem; color: #e2f1e7; margin: 16px 0 20px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 28px; }
  .badges li { background: var(--gold-soft); color: var(--on-gold); border-radius: 999px; padding: 4px 14px; font-size: 0.9rem; font-weight: 600; font-family: var(--font-head); }
  .dots { position: absolute; z-index: 3; bottom: 24px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; }
  .dots button { width: 10px; height: 10px; border-radius: 5px; border: 0; padding: 0; background: rgb(255 255 255 / 0.45); cursor: pointer; transition: width 0.2s; }
  .dots button.active { background: #fff; width: 28px; }

  .stats-wrap { padding-block: 40px 0; }
  .stat { display: grid; gap: 2px; text-align: center; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 22px 16px; }
  .stat strong { font-family: var(--font-head); font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); color: var(--green); line-height: 1.2; font-weight: 600; }
  .stat span { font-size: 0.92rem; color: var(--muted); }

  .oem { display: grid; gap: 32px; align-items: center; }
  .oem img { border-radius: var(--radius); box-shadow: var(--shadow); }
  @media (min-width: 900px) { .oem { grid-template-columns: 1fr 1fr; } }
  .free { font-size: 1.15rem; font-weight: 700; color: var(--red); }

  .certs { list-style: none; padding: 0; margin: 0; }
  .certs li { display: grid; gap: 6px; padding: 20px; border: 1px solid var(--border); border-left: 4px solid var(--green); border-radius: var(--radius); background: #fff; }
  .certs strong { color: var(--primary); }
</style>
