---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaSample from '../../components/CtaSample.astro';
import { products } from '../../data/products';
import { site } from '../../data/site';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/products/${p.slug}`, site.url).href,
    name: p.name,
  })),
};
---
<Base
  title="สินค้าและสเปกถุงขยะสำหรับองค์กร"
  description="แคตตาล็อกถุงขยะ B2B ถุงขยะติดเชื้อสีแดง ถุงขยะรีไซเคิล ถุงขยะดำงานหนัก และถุงขยะแยกประเภท 4 สี พร้อมตารางสเปกความหนาและจำนวนใบต่อกิโลกรัม"
  jsonLd={ld}
>
  <PageHero
    title="สินค้าและสเปกเชิงเทคนิค"
    lead="เลือกกลุ่มสินค้าเพื่อดูตารางขนาด ความหนา และจำนวนใบต่อกิโลกรัม สำหรับเทียบ TOR หรือคำนวณต้นทุน"
    crumbs={[{ name: 'สินค้า' }]}
  />
  <section class="section">
    <div class="wrap grid grid-2">{products.map((p) => <ProductCard p={p} />)}</div>
  </section>
  <div class="wrap"><CtaSample /></div>
</Base>
